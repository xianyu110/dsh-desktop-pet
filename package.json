{
  "name": "dsh-desktop-pet",
  "version": "0.1.0",
  "private": true,
  "author": "xiaoshihou",
  "description": "Windows desktop companion for DeepSeek Harness",
  "main": "src/main.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack:win": "electron-builder --win --x64 --dir",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.xiaoshihou.dsh-desktop-pet",
    "productName": "dafeiyu",
    "executableName": "大肥鱼",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "dsh-desktop-pet-${version}-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "dsh-desktop-pet-${version}-windows-${arch}-portable.${ext}"
    }
  },
  "license": "MIT"
}
